# Web tier settings, used by: sudo bash scripts/install.sh web --env-file frontend/.env
# Internal ALB DNS of the app tier, no trailing slash
BACKEND_URL=http://internal-app-alb-xxxxxxxx.us-east-1.elb.amazonaws.com
# Optional: DNS server Nginx uses to look up BACKEND_URL (auto: 169.254.169.253 on EC2)
# DNS_RESOLVER=169.254.169.253
